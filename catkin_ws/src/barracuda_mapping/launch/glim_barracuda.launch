<launch>
  <!-- Barracuda-specific GLIM launch file -->
  <!-- This launch file integrates GLIM SLAM with the barracuda robot setup -->
  
  <!-- Robot namespace -->
  <arg name="robot_ns" default="barracuda" />
  
  <!-- Frame IDs for barracuda robot -->
  <arg name="map_frame" default="map" />
  <arg name="odom_frame" default="$(arg robot_ns)/odom" />
  <arg name="base_frame" default="$(arg robot_ns)/base_link" />
  <arg name="imu_frame" default="$(arg robot_ns)/imu" />
  <arg name="lidar_frame" default="$(arg robot_ns)/sonar" />
  
  <!-- Input topics -->
  <arg name="pointcloud_topic" default="/$(arg robot_ns)/mapping/scan_pointcloud" />
  <arg name="imu_topic" default="/$(arg robot_ns)/imu/data" />
  
  <!-- GLIM configuration -->
  <arg name="config_path" default="$(find barracuda_mapping)/config/glim" />
  
  <group ns="$(arg robot_ns)">
    <!-- GLIM SLAM node -->
    <node pkg="glim_ros" type="glim_rosnode" name="glim_rosnode" output="screen">
      <param name="config_path" value="$(arg config_path)" />
      
      <!-- Remap input topics -->
      <remap from="/glim_ros/imu" to="$(arg imu_topic)" />
      <remap from="/glim_ros/points" to="$(arg pointcloud_topic)" />
      
      <!-- Frame parameters -->
      <param name="map_frame_id" value="$(arg map_frame)" />
      <param name="odom_frame_id" value="$(arg odom_frame)" />
      <param name="base_frame_id" value="$(arg base_frame)" />
      <param name="imu_frame_id" value="$(arg imu_frame)" />
      <param name="lidar_frame_id" value="$(arg lidar_frame)" />
      
      <!-- Disable debug output by default -->
      <param name="debug" value="false" />
    </node>
    
    <!-- Keep the existing pointcloud conversion nodes -->
    <include file="$(find barracuda_mapping)/launch/convert_pointcloud.launch" />
  </group>
  
  <!-- Static transforms if needed -->
  <!-- Example: IMU to base_link transform -->
  <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="imu_to_base_link" 
             args="0 0 0 0 0 0 $(arg base_frame) $(arg imu_frame)" /> -->
</launch>