<launch>
  <!-- Legacy launch file - now uses unified mapping system -->
  <!-- To use original GTSAM SLAM, set use_glim="false" -->
  <arg name="use_glim" default="true" doc="Use GLIM SLAM (true) or original GTSAM SLAM (false)" />
  
  <include file="$(find barracuda_mapping)/launch/unified_mapping.launch">
    <arg name="use_glim" value="$(arg use_glim)" />
  </include>
</launch>
